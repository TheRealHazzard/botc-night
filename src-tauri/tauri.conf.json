{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "botc-night",
  "version": "0.1.0",
  "identifier": "com.botcnight.app",
  "build": {
    "frontendDist": "../public/dist/host",
    "beforeBuildCommand": "npm run build && npm run package:server"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/botc-night-server"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
